# Required secrets only (copy to .env.local / Netlify UI).
# Public config is committed elsewhere:
#   Firebase Web → lib/firebase/public-config.ts
#   GA4          → lib/observability/public-config.ts
#   App URL      → netlify.toml / PRODUCTION_APP_URL (https://rotasambandh.com)

# Firebase Admin (Netlify server / local API routes)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 (resumes — private)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 (public company logos)
R2_LOGOS_BUCKET=rotasambandhassets
R2_PUBLIC_BASE_URL=https://assets.rotasambandh.com

# Firebase Web push (Cloud Messaging → Web Push certificates → Key pair)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Android Capacitor push: place google-services.json at android/app/google-services.json
# (Firebase Console → Project settings → Your apps → Android). Do not commit secrets beyond
# the standard google-services client config if your policy forbids it.
